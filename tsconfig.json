{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "outDir": "./fe/dist",
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./fe/src/*"],
      "react": ["./fe/node_modules/@types/react"],
      "react/*": ["./fe/node_modules/@types/react/*"],
      "react-dom": ["./fe/node_modules/@types/react-dom"],
      "lucide-react": ["./fe/node_modules/lucide-react"]
    }
  },
  "include": [
    "fe/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "fe/dist",
    "fe/node_modules",
    "be/node_modules"
  ]
}
